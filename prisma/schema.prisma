generator client {
  provider = "prisma-client-js"
  output          = "../generated/prisma/client"  // must match the import path
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id        String    @id
  email     String    @unique
  name      String?
  yarns     Yarn[]
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Yarn {
  id        String   @id @default(cuid())
  name      String
  brand     String?
  weight    String?
  colour    String?
  quantity  Int?
  notes     String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects  ProjectYarn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  name      String
  status    ProjectStatus @default(PLANNED)
  notes     String?
  startDate DateTime?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  yarns     ProjectYarn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectYarn {
  projectId String
  yarnId    String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  yarn      Yarn    @relation(fields: [yarnId], references: [id], onDelete: Cascade)

  @@id([projectId, yarnId])
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}